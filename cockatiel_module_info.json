{
  "name": "stress-test",
  "description": "Engine stress test \u2014 validates auth flow and all message types. DEV/benchmark tool: NOT a runtime consumer, do not autostart.",
  "version": "0.1.0",
  "capabilities": "input",
  "root_file": "./src/main.rs",
  "launch_command": "cargo",
  "command_flags": [
    "run",
    "--release"
  ],
  "autostart": false,
  "terminal": false,
  "binary": {
    "macos": {
      "x86_64": "target/release/cockatiel-stress-test",
      "aarch64": "target/release/cockatiel-stress-test",
      "arm": "target/release/cockatiel-stress-test"
    },
    "linux": {
      "x86_64": "target/release/cockatiel-stress-test",
      "aarch64": "target/release/cockatiel-stress-test",
      "arm": "target/release/cockatiel-stress-test"
    },
    "windows": {
      "x86_64": "target/release/cockatiel-stress-test.exe",
      "aarch64": "target/release/cockatiel-stress-test.exe",
      "arm": "target/release/cockatiel-stress-test.exe"
    }
  },
  "build_command": "cargo",
  "build_flags": [
    "build",
    "--release"
  ]
}